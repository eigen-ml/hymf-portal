# ==============================================================================
# HYMF Portal - Çevre Değişkenleri (Environment Variables)
# ==============================================================================

# Supabase Bağlantı Bilgileri (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Demo Modu: true yapılırsa demo rol değiştirici ve örnek hesaplar görünür; canlıda false
NEXT_PUBLIC_DEMO_MODE=false

# Yalnız sunucu: "Üye ekle" ve "Şifre sıfırla" bununla çalışır. NEXT_PUBLIC_ önekiyle asla eklemeyin,
# commit'lemeyin. Yerelde gerekmiyorsa boş bırakın (Supabase -> Settings -> API Keys -> service_role).
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot Entegrasyonu (@BotFather üzerinden alınan Token ve Grup ID)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Uygulama Temel URL'i (Lokalde http://localhost:3000, Canlıda Vercel linkiniz)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Yalnız sunucu: lisanslı VASP paketinin Drive bağlantısı (Kılavuzlar → TRUBA, yalnız üyeler görür). Repoya
# yazılmaz; boşsa sayfada "Paket bağlantısı henüz eklenmedi" notu çıkar. https:// ile başlamalı.
VASP_PAKET_URL=
